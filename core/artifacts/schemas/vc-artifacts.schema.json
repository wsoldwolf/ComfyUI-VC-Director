{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VC-Director V1 draft 0.3 artifacts and stage payloads",
  "description": "Structural contracts; reference, temporal, speech and policy invariants require semantic validation.",
  "oneOf": [
    {
      "$ref": "#/$defs/scenario"
    },
    {
      "$ref": "#/$defs/enhanced_story"
    },
    {
      "$ref": "#/$defs/scene_document"
    },
    {
      "$ref": "#/$defs/execution"
    },
    {
      "$ref": "#/$defs/enhance_request"
    },
    {
      "$ref": "#/$defs/enhance_response"
    },
    {
      "$ref": "#/$defs/outline_request"
    },
    {
      "$ref": "#/$defs/outline_response"
    },
    {
      "$ref": "#/$defs/detail_request"
    },
    {
      "$ref": "#/$defs/detail_response"
    },
    {
      "$ref": "#/$defs/retime_request"
    },
    {
      "$ref": "#/$defs/retime_response"
    }
  ],
  "$defs": {
    "source_span": {
      "type": "object",
      "properties": {
        "document": {
          "enum": [
            "scenario",
            "scene"
          ]
        },
        "first_line": {
          "type": "integer",
          "minimum": 1
        },
        "last_line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "document",
        "first_line",
        "last_line"
      ],
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "image_asset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "video_asset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "voice_asset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "image_asset_id",
        "video_asset_id",
        "voice_asset_id"
      ],
      "additionalProperties": false
    },
    "background": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "image_asset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "description",
        "image_asset_id"
      ],
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source_span"
        }
      },
      "required": [
        "id",
        "text",
        "source"
      ],
      "additionalProperties": false
    },
    "audio_reference": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "purpose": {
          "enum": [
            "music",
            "ambience",
            "effects"
          ]
        }
      },
      "required": [
        "asset_id",
        "purpose"
      ],
      "additionalProperties": false
    },
    "audio_policy": {
      "type": "object",
      "properties": {
        "vocal": {
          "enum": [
            "none",
            "dialogue"
          ]
        },
        "bgm": {
          "enum": [
            "none",
            "generate"
          ]
        },
        "bgm_description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "ambience": {
          "enum": [
            "none",
            "explicit",
            "expand"
          ]
        },
        "ambience_description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "effects": {
          "enum": [
            "none",
            "explicit",
            "expand"
          ]
        },
        "effects_description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_audio": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/audio_reference"
          },
          "minItems": 0
        }
      },
      "required": [
        "vocal",
        "bgm",
        "bgm_description",
        "ambience",
        "ambience_description",
        "effects",
        "effects_description",
        "reference_audio"
      ],
      "additionalProperties": false
    },
    "dialogue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "language": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source_span"
        }
      },
      "required": [
        "id",
        "actor_id",
        "language",
        "text",
        "source"
      ],
      "additionalProperties": false
    },
    "beat": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "background_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "source": {
          "$ref": "#/$defs/source_span"
        },
        "dialogues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dialogue"
          },
          "minItems": 0
        },
        "audio": {
          "$ref": "#/$defs/audio_policy"
        }
      },
      "required": [
        "id",
        "text",
        "actor_ids",
        "background_id",
        "source",
        "dialogues",
        "audio"
      ],
      "additionalProperties": false
    },
    "required_event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "beat_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source_span"
        }
      },
      "required": [
        "id",
        "beat_id",
        "text",
        "source"
      ],
      "additionalProperties": false
    },
    "enhanced_beat": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "required_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/required_event"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "intent",
        "required_events"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "owner_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "owner_id",
        "key",
        "value"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "kind": {
          "enum": [
            "action",
            "camera",
            "dialogue"
          ]
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "dialogue_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "start_ms",
        "end_ms",
        "actor_id",
        "text",
        "dialogue_id",
        "language"
      ],
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "start_ms",
        "end_ms",
        "events"
      ],
      "additionalProperties": false
    },
    "sound_event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "kind": {
          "enum": [
            "effect",
            "ambience"
          ]
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "trigger_event_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "start_ms",
        "end_ms",
        "trigger_event_id",
        "text"
      ],
      "additionalProperties": false
    },
    "scene_outline": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "beat_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "background_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "transition": {
          "enum": [
            "cut",
            "continue"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "locked": {
          "type": "array",
          "items": {
            "enum": [
              "structure",
              "timing",
              "content"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "required_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "initial_state": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          },
          "minItems": 0
        },
        "terminal_state": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "beat_id",
        "start_ms",
        "end_ms",
        "actor_ids",
        "background_id",
        "transition",
        "depends_on",
        "locked",
        "required_event_ids",
        "initial_state",
        "terminal_state"
      ],
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "beat_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "background_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "transition": {
          "enum": [
            "cut",
            "continue"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "locked": {
          "type": "array",
          "items": {
            "enum": [
              "structure",
              "timing",
              "content"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "required_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "initial_state": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          },
          "minItems": 0
        },
        "terminal_state": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          },
          "minItems": 0
        },
        "subject_descriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actor_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "actor_id",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "retention": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actor_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "mode": {
                "enum": [
                  "fully_preserved",
                  "partially_preserved"
                ]
              }
            },
            "required": [
              "actor_id",
              "mode"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "audio": {
          "$ref": "#/$defs/audio_policy"
        },
        "shots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shot"
          },
          "minItems": 1
        },
        "sound_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sound_event"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "beat_id",
        "start_ms",
        "end_ms",
        "actor_ids",
        "background_id",
        "transition",
        "depends_on",
        "locked",
        "required_event_ids",
        "initial_state",
        "terminal_state",
        "subject_descriptions",
        "summary",
        "retention",
        "audio",
        "shots",
        "sound_events"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "kind": {
          "enum": [
            "image",
            "audio",
            "video"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "sample_rate": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sample_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "fps": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "frame_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "paired_audio_enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "sha256",
        "locator",
        "sample_rate",
        "sample_count",
        "fps",
        "frame_count",
        "paired_audio_enabled"
      ],
      "additionalProperties": false
    },
    "reference_binding": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "role": {
          "enum": [
            "identity",
            "background",
            "motion",
            "voice",
            "music",
            "ambience",
            "effects",
            "video_audio"
          ]
        },
        "token": {
          "type": "string",
          "pattern": "^<(Picture|Video|Audio) [1-9]>$"
        }
      },
      "required": [
        "asset_id",
        "role",
        "token"
      ],
      "additionalProperties": false
    },
    "event_timing": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "planned_start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "planned_end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "raw_start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "raw_end_frame": {
          "type": "integer",
          "minimum": 1
        },
        "output_start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "output_end_frame": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "event_id",
        "planned_start_ms",
        "planned_end_ms",
        "raw_start_frame",
        "raw_end_frame",
        "output_start_frame",
        "output_end_frame"
      ],
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "scene_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "planned_start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "planned_end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame": {
          "type": "integer",
          "minimum": 1
        },
        "raw_length": {
          "type": "integer",
          "minimum": 1
        },
        "context_frames": {
          "type": "integer",
          "minimum": 0
        },
        "audio_context_frames": {
          "type": "integer",
          "minimum": 0
        },
        "local_subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actor_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "subject_number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              }
            },
            "required": [
              "actor_id",
